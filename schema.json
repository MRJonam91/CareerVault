{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/MRJonam91/CareerVault/main/schema.json",
  "title": "CareerVault Profile",
  "description": "Deterministic career ledger schema and single source of truth for professional histories, verifiable achievements, and bilingual CV exports.",
  "type": "object",
  "required": ["schemaVersion", "basics", "experiences", "skills"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "URI of the JSON Schema"
    },
    "schemaVersion": {
      "type": "string",
      "description": "Schema version (e.g. '1.0.0')",
      "enum": ["1.0.0"]
    },
    "basics": {
      "type": "object",
      "description": "Personal and professional baseline details",
      "required": ["name", "email", "label", "summary"],
      "properties": {
        "name": { "type": "string", "description": "Full legal or professional name" },
        "label": {
          "description": "Professional headline or target title (localized or string)",
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "required": ["it", "en"],
              "properties": { "it": { "type": "string" }, "en": { "type": "string" } }
            }
          ]
        },
        "email": { "type": "string", "format": "email", "description": "Primary contact email" },
        "phone": { "type": "string", "description": "Contact phone number" },
        "url": { "type": "string", "format": "uri", "description": "Personal website or portfolio URL" },
        "summary": {
          "description": "Executive summary or professional bio",
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "required": ["it", "en"],
              "properties": { "it": { "type": "string" }, "en": { "type": "string" } }
            }
          ]
        },
        "location": {
          "type": "object",
          "properties": {
            "city": { "type": "string" },
            "region": { "type": "string" },
            "countryCode": { "type": "string", "minLength": 2, "maxLength": 2 }
          }
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["network", "username", "url"],
            "properties": {
              "network": { "type": "string" },
              "username": { "type": "string" },
              "url": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    },
    "experiences": {
      "type": "array",
      "description": "Chronological work experiences and roles",
      "items": {
        "type": "object",
        "required": ["id", "company", "role", "employmentType", "startDate", "highlights", "skills"],
        "properties": {
          "id": { "type": "string", "description": "Unique slug identifier for the role" },
          "company": { "type": "string", "description": "Employer or client organization name" },
          "role": {
            "description": "Role or title",
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["it", "en"],
                "properties": { "it": { "type": "string" }, "en": { "type": "string" } }
              }
            ]
          },
          "employmentType": {
            "type": "string",
            "enum": ["full-time", "part-time", "contract", "freelance", "internship"]
          },
          "location": { "type": "string" },
          "startDate": {
            "type": "string",
            "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])(?:-(?:0[1-9]|[12]\\d|3[01]))?$",
            "description": "Start date (YYYY-MM or YYYY-MM-DD)"
          },
          "endDate": {
            "type": ["string", "null"],
            "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])(?:-(?:0[1-9]|[12]\\d|3[01]))?$",
            "description": "End date or null if current"
          },
          "isCurrent": { "type": "boolean" },
          "isConcurrent": { "type": "boolean", "description": "Set true if role legitimately overlapped with another full-time role" },
          "summary": {
            "oneOf": [
              { "type": "string" },
              { "type": "object", "properties": { "it": { "type": "string" }, "en": { "type": "string" } } }
            ]
          },
          "highlights": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string" },
                { "type": "object", "properties": { "it": { "type": "string" }, "en": { "type": "string" } } }
              ]
            }
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "value"],
              "properties": {
                "label": {
                  "oneOf": [
                    { "type": "string" },
                    { "type": "object", "properties": { "it": { "type": "string" }, "en": { "type": "string" } } }
                  ]
                },
                "value": { "type": "string" },
                "impact": {
                  "oneOf": [
                    { "type": "string" },
                    { "type": "object", "properties": { "it": { "type": "string" }, "en": { "type": "string" } } }
                  ]
                }
              }
            }
          },
          "skills": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string", "format": "uri" }
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "description": "Inventory of competencies and tools",
      "items": {
        "type": "object",
        "required": ["name", "category"],
        "properties": {
          "name": { "type": "string" },
          "category": {
            "type": "string",
            "enum": ["languages", "frameworks", "databases", "cloud-devops", "architecture", "tools", "management", "other"]
          },
          "level": {
            "type": "string",
            "enum": ["beginner", "intermediate", "advanced", "expert"]
          },
          "yearsOfExperience": { "type": "number" },
          "lastUsed": { "type": "string", "pattern": "^\\d{4}$" }
        }
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "institution", "area", "studyType", "startDate"],
        "properties": {
          "id": { "type": "string" },
          "institution": { "type": "string" },
          "area": {
            "oneOf": [
              { "type": "string" },
              { "type": "object", "properties": { "it": { "type": "string" }, "en": { "type": "string" } } }
            ]
          },
          "studyType": {
            "oneOf": [
              { "type": "string" },
              { "type": "object", "properties": { "it": { "type": "string" }, "en": { "type": "string" } } }
            ]
          },
          "startDate": { "type": "string" },
          "endDate": { "type": ["string", "null"] },
          "score": { "type": "string" }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "skills"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": {
            "oneOf": [
              { "type": "string" },
              { "type": "object", "properties": { "it": { "type": "string" }, "en": { "type": "string" } } }
            ]
          },
          "url": { "type": "string", "format": "uri" },
          "skills": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "issuer", "issueDate"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "issuer": { "type": "string" },
          "issueDate": { "type": "string" },
          "credentialId": { "type": "string" },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["language", "fluency"],
        "properties": {
          "language": {
            "oneOf": [
              { "type": "string" },
              { "type": "object", "properties": { "it": { "type": "string" }, "en": { "type": "string" } } }
            ]
          },
          "fluency": {
            "type": "string",
            "enum": ["native", "fluent", "c2", "c1", "b2", "b1", "a2", "a1"]
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "lastUpdated": { "type": "string" },
        "version": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
