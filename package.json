{
  "name": "careervault",
  "version": "0.2.0",
  "description": "Deterministic career ledger & single source of truth: validate career histories, detect CV anomalies, and export verifiable Italian & English Markdown résumés and JSON Resume.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Manoj Rollo <fbxmano@gmail.com> (https://github.com/MRJonam91)",
  "homepage": "https://github.com/MRJonam91/CareerVault#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MRJonam91/CareerVault.git"
  },
  "bugs": {
    "url": "https://github.com/MRJonam91/CareerVault/issues"
  },
  "keywords": [
    "careervault",
    "cv",
    "resume",
    "career",
    "career-ledger",
    "single-source-of-truth",
    "resume-generator",
    "markdown-resume",
    "json-resume",
    "portfolio",
    "skill-matrix",
    "curriculum-vitae",
    "bilingual-cv",
    "cli",
    "typescript"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "careervault": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.it.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "start": "node src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/MRJonam91"
    },
    {
      "type": "ko-fi",
      "url": "https://ko-fi.com/mrjonam"
    },
    {
      "type": "buymeacoffee",
      "url": "https://buymeacoffee.com/mrjonam"
    },
    {
      "type": "paypal",
      "url": "https://paypal.me/manorollo"
    }
  ],
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.7.3"
  }
}
